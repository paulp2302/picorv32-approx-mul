# Read in the required verilog files
read_verilog ../2x2/Approx2x2Mul.v
read_verilog Approx4x4MulV1.v

# High level synthesis processes
hierarchy -check -auto-top
proc
clean
opt
clean

# Fine level synthesis
opt -full
clean
stat

# Write the syntesized multiplier to file
# synth_ice40
write_verilog synth/Approx4x4MulV1.v
